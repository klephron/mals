{
  "logs": [
    {
      "name": "stderr",
      "level": "info",
      "kind": "file",
      "file": "/dev/stderr"
    }
  ],
  "models": [
    {
      "name": "Llama-3.2-1B-Instruct-Q6_K",
      "kind": "openai",
      "settings": {
        "url": "http://localhost:9652",
        "max_tokens": 250,
        "temperature": 0.5
      }
    }
  ],
  "lsps": [],
  "usages": [
    {
      "name": "completion",
      "events": ["textDocument/completion"],
