{
  "loggers": [
    {
      "name": "stderr",
      "level": "info",
      "kind": "file",
      "file": "/dev/stderr"
    }
  ],
  "models": [],
  "lsps": [
    {
      "name": "clangd",
      "kind": "stdio",
      "settings": {
        "cmd": ["clangd"]
      }
    }
  ],
  "usages": [
    {
      "name": "completion",
      "events": ["textDocument/completion"],
      "workflow": {
        "steps": [
          {
            "name": "lsp",
            "lsp": "clangd",
            "scope": "client"
          }
        ]
      }
    },
    {
      "name": "lspsync",
      "events": [
        "initialize",
        "initialized",
        "textDocument/didiOpen",
        "textDocument/didChange",
        "textDocument/didClose",
        "shutdown"
      ],
      "workflow": {
        "steps": [
          {
            "name": "lsp",
            "scope": "client",
            "lsp": "clangd"
          }
        ]
      }
    }
  ],
  "listeners": [
    {
      "name": "lsp-tcp:9651",
      "kind": "lsp",
      "ipc": "tcp",
      "port": 9651,
      "usages": ["lspsync", "completion"]
    },
    {
      "name": "api-tcp:9650",
      "kind": "api",
      "ipc": "tcp",
      "port": 9650
    }
  ]
}
