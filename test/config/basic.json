{
  "loggers": [
    {
      "name": "stderr",
      "level": "info",
      "kind": "file",
      "file": "/dev/stderr"
    }
  ],
  "models": [
    {
      "name": "Llama-3.2-1B-Instruct-Q6_K",
      "kind": "openai",
      "settings": {
        "url": "http://localhost:9652",
        "max_tokens": 250,
        "temperature": 0.5
      }
    }
  ],
  "lsps": [
    {
      "name": "clangd",
      "kind": "stdio",
      "settings": {
        "cmd": ["clangd"]
      }
    }
  ],
  "usages": [
    {
      "name": "lspsync",
      "events": [
        "initialize",
        "initialized",
        "textDocument/didiOpen",
        "textDocument/didChange",
        "textDocument/didClose",
        "shutdown"
      ],
      "workflow": {
        "steps": [
          {
            "name": "lsp",
            "scope": "client",
            "lsp": "clangd"
          }
        ]
      }
    },
    {
      "name": "completion",
      "events": ["textDocument/completion"],
      "conditions": [
        {
          "filetypes": [".*"],
          "paths": [".*"]
        }
      ],
      "workflow": {
        "steps": [
          {
            "name": "lsp",
            "conditions": [
              {
                "filetypes": [".*"],
                "paths": [".*"]
              }
            ],
            "lsp": "clangd",
            "scope": "client",
          },
          {
            "name": "llm",
            "model": "Llama-3.2-1B-Instruct-Q6_K"
            "scope": "global",
          }
        ]
      }
    }
  ],
  "listeners": [
    {
      "name": "lsp-tcp:9651",
      "kind": "lsp",
      "ipc": "tcp",
      "port": 9651,
      "usages": ["lspsync", "completion"]
    },
    {
      "name": "api-tcp:9650",
      "kind": "api",
      "ipc": "tcp",
      "port": 9650,
    }
  ]
}
